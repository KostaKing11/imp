{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "firebase-emulator",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "firebase",
        "emulators:start",
        "--only",
        "database,auth",
        "--project",
        "demo-imp"
      ],
      "port": 9000
    },
    {
      "name": "imp-relay",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server/relay-node.mjs"],
      "port": 8790
    },
    {
      "name": "imp-web-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "dist", "-l", "8088", "-s"],
      "port": 8088
    }
  ]
}
