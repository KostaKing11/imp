{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "firebase-emulator",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "firebase",
        "emulators:start",
        "--only",
        "database,auth",
        "--project",
        "demo-imp"
      ],
      "port": 9000
    },
    {
      "name": "imp-web-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "serve",
        "dist",
        "-l",
        "8088",
        "-s"
      ],
      "port": 8088
    },
    {
      "name": "imp-web-subpath",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "serve",
        "C:/Users/KOSTA/AppData/Local/Temp/claude/C--Users-KOSTA-Desktop-IMP-FINALLY/43e7b521-7ad1-470c-80b2-f552cc67a841/scratchpad/site",
        "-l",
        "8089"
      ],
      "port": 8089
    }
  ]
}
