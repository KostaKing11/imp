{
  "name": "imp",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.0",
    "expo-camera": "~56.0.8",
    "expo-network": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "firebase": "^12.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-udp": "^4.1.7",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "esbuild": "^0.28.1",
    "firebase-tools": "^15.24.0",
    "gh-pages": "^6.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-web.ps1",
    "web:serve": "npx -y serve dist -l 8088 -s",
    "web:deploy": "npm run web:build && npx gh-pages --nojekyll -d dist",
    "apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "apk:build": "cd android && .\\gradlew.bat assembleRelease",
    "apk:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "emulator": "firebase emulators:start --only database,auth --project demo-imp",
    "test:room": "npx esbuild scripts/test-firebase-room.mjs --bundle --platform=node --format=esm --packages=external --outfile=.tmp-test.mjs && node .tmp-test.mjs",
    "test:rules": "npx esbuild scripts/test-firebase-rules.mjs --bundle --platform=node --format=esm --packages=external --outfile=.tmp-test.mjs && node .tmp-test.mjs"
  },
  "private": true
}
