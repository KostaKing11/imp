{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".validate": "$code.matches(/^[0-9]{4}$/) != null",
        ".write": "auth != null && data.child('host').child('uid').val() === auth.uid",
        "host": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'at']) && newData.child('uid').val() === auth.uid)",
          "uid": {
            ".validate": "newData.isString()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "peers": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('host').child('uid').val() === auth.uid)",
            ".validate": "!newData.exists() || newData.hasChild('at')",
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "toHost": {
          ".read": "auth != null && root.child('rooms').child($code).child('host').child('uid').val() === auth.uid",
          "$msgId": {
            ".write": "auth != null && (!data.exists() || root.child('rooms').child($code).child('host').child('uid').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChildren(['from', 'data']) && newData.child('from').val() === auth.uid)"
          }
        },
        "toPeer": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('host').child('uid').val() === auth.uid)",
            "$msgId": {
              ".validate": "!newData.exists() || newData.hasChild('data')"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
